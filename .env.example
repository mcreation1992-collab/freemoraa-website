DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=flipkart_clone_new

# License (production only): binds the site to the client's domain.
# Leave empty during development - localhost, 127.0.0.1 and LAN IPs are
# always allowed without a key.
# Issue a key with: node scripts/generate-license-key.mjs <client-domain>
LICENSE_DOMAIN=
LICENSE_KEY=

# Razorpay TEST/SANDBOX credentials (variable names only - never commit real values)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Legacy PHP project root - ONLY used by the CSV import / image storage layer
# (CSV uploads, import jobs and product image mirrors live under it). Optional;
# defaults to a sibling "flipkart-clone" directory (local XAMPP layout).
PHP_PROJECT_ROOT=

# Native Next.js admin session signing secret (HMAC-SHA256 signed cookie).
# REQUIRED in production - the admin panel fails closed without it.
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and set it in the Hostinger environment variables panel (never commit it).
AUTH_SECRET=